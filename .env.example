# Copy this file to .env for local dev. On Render, set these as service env vars instead
# (render.yaml already declares which ones it needs).

# Local dev: leave unset to use SQLite automatically.
# Production: your Neon connection string, e.g.
#   postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# From https://console.groq.com/keys — free, no credit card required.
GROQ_API_KEY=gsk_...

# Random long string used to sign login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=*
